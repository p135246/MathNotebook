Notebook[{

Cell[CellGroupData[{
Cell["ConvertLaTeXToMaTeX", "ObjectName",
 CellID->606906579,ExpressionUUID->"22b40e05-64f5-4304-b23b-01b9a0484ea8"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"d0e3192a-da39-6fab-1c36-20bc4dc3ebf9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConvertLaTeXToMaTeX",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ConvertLaTeXToMaTeX"], 
   RowBox[{"[", "]"}]}]], "InlineFormula",ExpressionUUID->
  "e88e517c-9ecb-a9a0-45e7-a98e9b7887f7"],
 " \[LineSeparator]",
 "renders the LaTeX source held as text in the selected cells with MaTeX. A cell that is one display formula -- $$..$$, \\[..\\], equation, align, gather, multline, alignat, starred or not -- or a bare fragment renders whole; prose renders piecewise, display spans as display cells and $..$ or \\(..\\) runs as inline islands. The source is stored on every rendered cell, so ConvertMaTeXToLaTeX gives back what was typed. Nothing is converted when nothing is selected.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConvertLaTeXToMaTeX",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ConvertLaTeXToMaTeX"], 
   RowBox[{"[", RowBox[{"{", 
     RowBox[{"cell", ", ", " ", "..."}], "}"}], "]"}]}]], "InlineFormula",ExpressionUUID->
  "12408bbf-6c4d-3673-92da-9c7ab2ecdf73"],
 " \[LineSeparator]",
 "renders the given cells."
}], "Usage",
 CellID->845075891,ExpressionUUID->"24463668-88d8-4d58-8a8b-81baa4524698"],

Cell[TextData[{
 StyleBox["cell",
  FontSlant->Italic],
 " is a ",
 Cell[BoxData[
  TemplateBox[{
   "CellObject", "paclet:ref/CellObject", 
    "https://reference.wolfram.com/language/ref/CellObject.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->"9af8139f-0058-47bb-b33b-a38ef16d2df8"],
 ", so both forms act on the front end. The function does nothing in a \
kernel with no front end. Nothing is converted when nothing is selected, where the other conversions would take the whole notebook."
}], "Notes",
 CellID->598485060,ExpressionUUID->"3aa19d20-6c65-4e9e-822a-23a1d043c58b"],

Cell[TextData[{
 "Requires a working MaTeX installation and a LaTeX distribution. Use ",
 Cell[BoxData[
  TemplateBox[{
   "InstallMaTeX", "paclet:WolframInstitute/MathNotebook/ref/InstallMaTeX", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
InstallMaTeX.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->"6391b7b1-c3f8-4ceb-a196-7f5f19d8a242"],
 " to set one up."
}], "Notes",
 CellID->476539167,ExpressionUUID->"c992f1dd-cce5-4bfd-9de4-e227c5af269b"],

Cell["\<\
Each selected cell is taken whole: the body inside its display \
delimiters where it carries them, and all of its text where it carries none. \
The source is recorded on the rendered cell, so the trip back gives exactly \
what was typed.\
\>", "Notes",
 CellID->712866198,ExpressionUUID->"48ca254d-1e74-45ae-bd14-fbca8444d30a"],

Cell[TextData[{
 "Rendered cells become images typeset by real LaTeX, so they match the \
journal's fonts exactly. They are no longer editable as boxes; use ",
 Cell[BoxData[
  TemplateBox[{
   "ConvertMaTeXToLaTeX", 
    "paclet:WolframInstitute/MathNotebook/ref/ConvertMaTeXToLaTeX", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
ConvertMaTeXToLaTeX.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->"ea362bb2-7e8c-4364-afba-c381a1192399"],
 " to get back the LaTeX source."
}], "Notes",
 CellID->294592418,ExpressionUUID->"40b1baef-76d4-493a-b14e-f09a782f56ef"],

Cell[TextData[{
 "Changing the math font size with ",
 Cell[BoxData[
  TemplateBox[{
   "SetMathFontSize", 
    "paclet:WolframInstitute/MathNotebook/ref/SetMathFontSize", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
SetMathFontSize.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->"2fc9ac94-803d-4287-8c00-f94d248a4c47"],
 " re-renders MaTeX cells, since their size is baked into the image."
}], "Notes",
 CellID->885250468,ExpressionUUID->"6fe18d05-2032-4100-b811-19b95fadb47a"]
}, Open  ]],

