Notebook[{

Cell[CellGroupData[{
Cell["ConvertToMaTeX", "ObjectName",
 CellID->133984591,ExpressionUUID->"eca0cdf3-e3e4-4726-95dc-e99337a986e3"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"96c0e9c0-4530-55bc-3817-64b3baf15b0e"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConvertToMaTeX",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ConvertToMaTeX"], 
   RowBox[{"[", "]"}]}]], "InlineFormula",ExpressionUUID->
  "a34ac6ab-762e-3f27-fd9c-805ca8f3c216"],
 " \[LineSeparator]",
 "renders the selected math with MaTeX -- display cells whole, inline islands in prose cells one by one -- or all of it if nothing is selected.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConvertToMaTeX",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ConvertToMaTeX"], 
   RowBox[{"[", "notebook", "]"}]}]], "InlineFormula",ExpressionUUID->
  "3000ed16-f96f-8300-2b8b-cd2a2a8b984d"],
 " \[LineSeparator]",
 "converts the given ",
 Cell[BoxData[
  StyleBox["notebook", "TI"]], "InlineFormula",ExpressionUUID->
  "36da669f-a872-cc4a-fdf6-566456968cf8"],
 ".",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConvertToMaTeX",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ConvertToMaTeX"], 
   RowBox[{"[", RowBox[{"{", 
     RowBox[{"cell", ", ", " ", "..."}], "}"}], "]"}]}]], "InlineFormula",ExpressionUUID->
  "ed4f1b81-2d33-002a-48ea-61e178ac35c8"],
 " \[LineSeparator]",
 "converts the given cells."
}], "Usage",
 CellID->225189278,ExpressionUUID->"a4bb2fc3-eaf8-4790-a0c9-3ece3dc4ca8c"],

Cell[TextData[{
 StyleBox["notebook",
  FontSlant->Italic],
 " is an open ",
 Cell[BoxData[
  TemplateBox[{
   "NotebookObject", "paclet:ref/NotebookObject", 
    "https://reference.wolfram.com/language/ref/NotebookObject.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "76746980-5995-477e-92f9-032925c43fae"],
 " and ",
 StyleBox["cell",
  FontSlant->Italic],
 " is a ",
 Cell[BoxData[
  TemplateBox[{
   "CellObject", "paclet:ref/CellObject", 
    "https://reference.wolfram.com/language/ref/CellObject.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "a8bd9ba7-93ca-4b6e-8fb1-b76af5c0476a"],
 ", so every form acts on the front end. The function does nothing in a \
kernel with no front end."
}], "Notes",
 CellID->562788374,ExpressionUUID->"961022f3-81ae-4217-8f24-cf7855d03d0b"],

Cell[TextData[{
 "Requires a working MaTeX installation and a LaTeX distribution. Use ",
 Cell[BoxData[
  TemplateBox[{
   "InstallMaTeX", "paclet:WolframInstitute/MathNotebook/ref/InstallMaTeX", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
InstallMaTeX.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "20c20ef6-5015-4611-aa37-8c5a11c438fe"],
 " to set one up."
}], "Notes",
 CellID->569924652,ExpressionUUID->"1f27f5e2-03a5-41c0-a914-2eedf7c906c1"],

Cell[TextData[{
 "Rendered cells become images typeset by real LaTeX, so they match the \
journal's fonts exactly. They are no longer editable as boxes; use ",
 Cell[BoxData[
  TemplateBox[{
   "ConvertFromMaTeX", 
    "paclet:WolframInstitute/MathNotebook/ref/ConvertFromMaTeX", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
ConvertFromMaTeX.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "867e5ef0-b906-40aa-8ce5-40baa75f9dce"],
 " to get back to native math."
}], "Notes",
 CellID->501532639,ExpressionUUID->"c9d62112-a73a-40f6-a518-eeb227a432ac"],

Cell[TextData[{
 "Changing the math font size with ",
 Cell[BoxData[
  TemplateBox[{
   "SetMathFontSize", 
    "paclet:WolframInstitute/MathNotebook/ref/SetMathFontSize", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
SetMathFontSize.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "3c5fc2d9-b7b6-4551-aff8-f8504d7b704b"],
 " re-renders MaTeX cells, since their size is baked into the image."
}], "Notes",
 CellID->900085808,ExpressionUUID->"3c5a564f-8139-49cb-8d98-4262d07144ad"]
}, Open  ]],

