Notebook[{

Cell[CellGroupData[{
Cell["ConvertFromMaTeX", "ObjectName",
 CellID->879636223,ExpressionUUID->"0d6e2da0-5fe3-4ed9-953d-2b29be25e8da"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"af08418b-45f2-36f6-bf57-c77dddbcdf46"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConvertFromMaTeX",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ConvertFromMaTeX"], 
   RowBox[{"[", "]"}]}]], "InlineFormula",ExpressionUUID->
  "4210126b-6590-1837-0194-3193ae34ce94"],
 " \[LineSeparator]",
 "converts the selected MaTeX-rendered math back to native typeset math, display cells and inline islands alike, or all of it if nothing is selected.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConvertFromMaTeX",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ConvertFromMaTeX"], 
   RowBox[{"[", "notebook", "]"}]}]], "InlineFormula",ExpressionUUID->
  "923f6677-9bb5-5593-a620-b7f58a2a9b18"],
 " \[LineSeparator]",
 "converts the given ",
 Cell[BoxData[
  StyleBox["notebook", "TI"]], "InlineFormula",ExpressionUUID->
  "30c5dd48-6e7d-0c9e-6702-93c970c43ed4"],
 ".",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConvertFromMaTeX",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ConvertFromMaTeX"], 
   RowBox[{"[", RowBox[{"{", 
     RowBox[{"cell", ", ", " ", "..."}], "}"}], "]"}]}]], "InlineFormula",ExpressionUUID->
  "9d1f432c-badc-440a-5954-def8213056fa"],
 " \[LineSeparator]",
 "converts the given cells."
}], "Usage",
 CellID->840918690,ExpressionUUID->"81aa4dbc-7dd9-4aa6-a2ab-2e801d03421d"],

Cell[TextData[{
 StyleBox["notebook",
  FontSlant->Italic],
 " is an open ",
 Cell[BoxData[
  TemplateBox[{
   "NotebookObject", "paclet:ref/NotebookObject", 
    "https://reference.wolfram.com/language/ref/NotebookObject.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "cd46d553-d7c9-4f14-a7bc-869fa381315a"],
 " and ",
 StyleBox["cell",
  FontSlant->Italic],
 " is a ",
 Cell[BoxData[
  TemplateBox[{
   "CellObject", "paclet:ref/CellObject", 
    "https://reference.wolfram.com/language/ref/CellObject.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "26574252-5500-4b63-959f-46ccf7e2dff6"],
 ", so every form acts on the front end. The function does nothing in a \
kernel with no front end."
}], "Notes",
 CellID->314623823,ExpressionUUID->"3c226e99-0c85-4a46-841a-a986c6d5f2f0"],

Cell[TextData[{
 "This is the inverse of ",
 Cell[BoxData[
  TemplateBox[{
   "ConvertToMaTeX", 
    "paclet:WolframInstitute/MathNotebook/ref/ConvertToMaTeX", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
ConvertToMaTeX.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->
  "cde08395-a190-4fab-ba09-db5baf2fb12d"],
 ". The native math is recovered from the source recorded on the cell, not \
read back out of the image."
}], "Notes",
 CellID->124403957,ExpressionUUID->"6c8aefdf-98e4-4ea3-8306-e78f43275e56"],

Cell["Cells that were never rendered with MaTeX are left alone.", "Notes",
 CellID->776277501,ExpressionUUID->"0053b231-1463-41bc-84e9-a72ca8a88645"]
}, Open  ]],

