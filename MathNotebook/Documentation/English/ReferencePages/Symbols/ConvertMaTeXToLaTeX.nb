Notebook[{

Cell[CellGroupData[{
Cell["ConvertMaTeXToLaTeX", "ObjectName",
 CellID->994924631,ExpressionUUID->"61aa267f-2183-4cca-ad4f-fef9bb1f8de4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"56077f10-3382-39c4-55b0-e242ab0d5daa"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConvertMaTeXToLaTeX",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ConvertMaTeXToLaTeX"], 
   RowBox[{"[", "]"}]}]], "InlineFormula",ExpressionUUID->
  "0372cca1-e2d1-c65a-ad30-e282fe332779"],
 " \[LineSeparator]",
 "turns the selected MaTeX-rendered math back into typed LaTeX, or all of it if nothing is selected. A cell rendered from typed source gives that source back verbatim; one rendered from typeset math gives the stored TeX wearing the delimiters its style implies; inline islands in prose re-wear their dollars in place.",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConvertMaTeXToLaTeX",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ConvertMaTeXToLaTeX"], 
   RowBox[{"[", "notebook", "]"}]}]], "InlineFormula",ExpressionUUID->
  "1d7c3b22-e2e8-da69-26be-666278880a1c"],
 " \[LineSeparator]",
 "converts the given ",
 Cell[BoxData[
  StyleBox["notebook", "TI"]], "InlineFormula",ExpressionUUID->
  "b964efb1-75c4-3226-2b59-fcc984d8112a"],
 ".",
 "\n",
 Cell[BoxData[
  RowBox[{
   ButtonBox["ConvertMaTeXToLaTeX",
    BaseStyle->"Link",
    ButtonData->"paclet:WolframInstitute/MathNotebook/ref/ConvertMaTeXToLaTeX"], 
   RowBox[{"[", RowBox[{"{", 
     RowBox[{"cell", ", ", " ", "..."}], "}"}], "]"}]}]], "InlineFormula",ExpressionUUID->
  "ae3b7781-3a6c-2972-678c-317afd186cb1"],
 " \[LineSeparator]",
 "converts the given cells."
}], "Usage",
 CellID->143486525,ExpressionUUID->"c4efa2c8-72ee-498e-95b6-5093d9ddfeb9"],

Cell[TextData[{
 StyleBox["notebook",
  FontSlant->Italic],
 " is an open ",
 Cell[BoxData[
  TemplateBox[{
   "NotebookObject", "paclet:ref/NotebookObject", 
    "https://reference.wolfram.com/language/ref/NotebookObject.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->"df3edfb6-08bf-4caf-8f14-e2a229df0352"],
 " and ",
 StyleBox["cell",
  FontSlant->Italic],
 " is a ",
 Cell[BoxData[
  TemplateBox[{
   "CellObject", "paclet:ref/CellObject", 
    "https://reference.wolfram.com/language/ref/CellObject.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->"96cf9296-31f9-42f1-8819-675fb6746387"],
 ", so every form acts on the front end. The function does nothing in a \
kernel with no front end."
}], "Notes",
 CellID->173549293,ExpressionUUID->"cfc14449-9ef5-4c22-bd6b-2339321f0341"],

Cell[TextData[{
 "This is the inverse of ",
 Cell[BoxData[
  TemplateBox[{
   "ConvertLaTeXToMaTeX", 
    "paclet:WolframInstitute/MathNotebook/ref/ConvertLaTeXToMaTeX", 
    "https://reference.wolfram.com/language/WolframInstitute/MathNotebook/ref/\
ConvertLaTeXToMaTeX.html"},
   "TextRefLink",
   DisplayFunction->(TagBox[
     ButtonBox[
      StyleBox[#, ShowStringCharacters -> True, FontFamily -> 
       "Source Sans Pro"], 
      BaseStyle -> {"Link", FontColor -> LightDarkSwitched[
          RGBColor[0.02, 0.286, 0.651], 
          RGBColor[0.2823, 0.6666, 0.949]]}, ButtonData -> #2, ContentPadding -> 
      False], 
     MouseAppearanceTag["LinkHand"]]& )]],ExpressionUUID->"52bb24b2-a721-451d-b28f-a5137f3dd749"],
 ". The LaTeX is the source recorded on the cell, not \
read back out of the image."
}], "Notes",
 CellID->588050003,ExpressionUUID->"92e22cda-5b32-4acf-82d4-ed845c71106f"],

Cell["\<\
A cell rendered from typed LaTeX gives that source back verbatim, \
delimiters and all. One rendered from typeset mathematics has no source of \
its own, and gives its stored TeX wearing the delimiters its style implies.\
\>", "Notes",
 CellID->479333037,ExpressionUUID->"52f93d0e-cc9d-4db3-8348-2e3f18382687"],

Cell["Cells that were never rendered with MaTeX are left alone.", "Notes",
 CellID->523174298,ExpressionUUID->"54598d31-7c3d-4ab1-aa90-d65c02c44edf"]
}, Open  ]],

