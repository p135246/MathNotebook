Package["WolframInstitute`MathNotebook`"]

CopyCellReference::usage = "CopyCellReference[] copies a live, clickable reference to the selected cell to the clipboard.\nCopyCellReference[notebook] copies a reference to the selected cell of the given notebook."
TagSelectedCell::usage = "TagSelectedCell[] assigns a cell tag to the selected cell, for use as a citation anchor.\nTagSelectedCell[notebook] tags the selected cell of the given notebook.\nTagSelectedCell[notebook, tag] assigns the given tag, without prompting."
GoBack::usage = "GoBack[] moves the selection back to the cell from which the last hyperlink was clicked."
InsertEnvironment::usage = "InsertEnvironment[style] inserts a new cell of the given environment style at the current position.\nInsertEnvironment[Automatic] carries the block the selection is in on into a new cell of that same style, showing no second name or number, so that prose written after a display equation inside a definition or a theorem still lines up with the rest of the block and still exports inside it.\nInsertEnvironment[notebook, style] inserts it into the given notebook."

InsertFrontMatter::usage = "InsertFrontMatter[] inserts empty Title, Author and Abstract cells at the top of the document and puts the cursor in the Title. The three export as \\title, \\author and an abstract environment, in the order \\maketitle needs them.\nInsertFrontMatter[notebook] inserts them into the given notebook."
InsertCitation::usage = "InsertCitation[] inserts a citation link to a tagged cell: a numbered environment is cited by its number, which follows the target when cells move, and a reference entry by its tag.\nInsertCitation[notebook] inserts it into the given notebook.\nInsertCitation[notebook, tag] cites the given tag, without prompting."
InsertReference::usage = "InsertReference[] adds a bibliography entry to the input notebook: a Reference cell tagged with the citation key it prompts for and labelled [key], as the citations to it read. The entry goes at the end of the bibliography rather than at the selection, and a notebook with none gets one, headed by an unnumbered References cell that prints nothing into the exported source. Where the entries come from a .bib file, that file stays the source of truth and the new entry does not reach the .tex.\nInsertReference[notebook] adds it to the given notebook.\nInsertReference[notebook, tag] uses the given key, without prompting."
SortBibliography::usage = "SortBibliography[] reorders the bibliography of the input notebook by the order of first citation, as BibTeX's unsrt does, moving the \\begin and \\end of the thebibliography to whichever entries become first and last.\nSortBibliography[\"method\"] orders the input notebook's bibliography: \"FirstUse\", \"Key\", \"Entry\" alphabetically on the entry text, or \"Uncited\", which sorts nothing and reports the entries no citation points at together with the citations pointing at no cell.\nSortBibliography[notebook] orders the given notebook by first use.\nSortBibliography[notebook, \"method\"] orders it by the given method. Where the entries come from a .bib file the order shown is the notebook's alone, that file and its bibliography style deciding the compiled one."
LabelReferences::usage = "LabelReferences[] labels every tagged Reference cell of the input notebook with its own tag, as the citations to it read, and clears the label of an untagged one.\nLabelReferences[notebook] labels the given notebook."
ConvertLaTeXCells::usage = "ConvertLaTeXCells[] converts LaTeX math fragments in the selected cells into native typeset math, or in the whole input notebook if nothing is selected.\nConvertLaTeXCells[notebook] converts the given notebook.\nConvertLaTeXCells[{cell, ...}] converts the given cells."
ConvertMathCells::usage = "ConvertMathCells[] converts native typeset math in the selected cells into LaTeX fragments, or in the whole input notebook if nothing is selected.\nConvertMathCells[notebook] converts the given notebook.\nConvertMathCells[{cell, ...}] converts the given cells."
ImportLaTeXDocument::usage = "ImportLaTeXDocument[\"file.tex\"] reads a LaTeX paper as a Notebook: sectioning and theorem-like environments become cells of the corresponding style, mathematics is converted, labels become cell tags, cross-references and citations become live buttons, a thebibliography or the entries of the paper's .bib become Reference cells, and everything else is carried verbatim so that ExportLaTeXDocument returns the source unchanged. The notebook opens on the MathNotebook stylesheet its \\documentclass asks for, or on PlainArticle when the class names no template."
ExportLaTeXDocument::usage = "ExportLaTeXDocument[notebook] writes a notebook read by ImportLaTeXDocument back out as LaTeX source.\nExportLaTeXDocument[notebook, \"file.tex\"] writes it to a file."
ExportLaTeXBundle::usage = "ExportLaTeXBundle[notebook, \"directory\"] writes the notebook out as a LaTeX paper together with everything it needs to compile: the .tex, every figure file its \\includegraphics commands name, every .bib its preamble declares, and — where a local pdfLaTeX is found — the .bbl, since arXiv runs LaTeX but not BibTeX. The result is a directory that tars into an arXiv submission. A file the paper names but that is not on disk is reported rather than omitted silently, and no compiled PDF is included, arXiv rejecting a source package that carries one.\nExportLaTeXBundle[notebook, \"directory\", opts] uses the given options."
ConvertToMaTeX::usage ="ConvertToMaTeX[] renders the selected math with MaTeX — display cells whole, inline islands in prose cells one by one — or all of it if nothing is selected.\nConvertToMaTeX[notebook] converts the given notebook.\nConvertToMaTeX[{cell, ...}] converts the given cells."
ConvertFromMaTeX::usage = "ConvertFromMaTeX[] converts the selected MaTeX-rendered math back to native typeset math, display cells and inline islands alike, or all of it if nothing is selected.\nConvertFromMaTeX[notebook] converts the given notebook.\nConvertFromMaTeX[{cell, ...}] converts the given cells."
ConvertLaTeXToMaTeX::usage = "ConvertLaTeXToMaTeX[] renders the LaTeX source held as text in the selected cells with MaTeX. A cell that is one display formula — $$..$$, \\[..\\], equation, align, gather, multline, alignat, starred or not — or a bare fragment renders whole; prose renders piecewise, display spans as display cells and $..$ or \\(..\\) runs as inline islands. The source is stored on every rendered cell, so ConvertMaTeXToLaTeX gives back what was typed. Nothing is converted when nothing is selected.\nConvertLaTeXToMaTeX[{cell, ...}] renders the given cells."
ConvertMaTeXToLaTeX::usage = "ConvertMaTeXToLaTeX[] turns the selected MaTeX-rendered math back into typed LaTeX, or all of it if nothing is selected. A cell rendered from typed source gives that source back verbatim; one rendered from typeset math gives the stored TeX wearing the delimiters its style implies; inline islands in prose re-wear their dollars in place.\nConvertMaTeXToLaTeX[notebook] converts the given notebook.\nConvertMaTeXToLaTeX[{cell, ...}] converts the given cells."
InstallMaTeX::usage = "InstallMaTeX[] installs and configures the MaTeX paclet."
OpenMaTeXPreferences::usage = "OpenMaTeXPreferences[] opens the user init.m file in the front end, creating it with a MaTeX preferences template if absent."
SetDocumentFontSize::usage = "SetDocumentFontSize[size] scales the input notebook so that Text is the given font size, on screen and in print, carrying its mathematics with it unless SetMathFontSize has been given a size of its own.\nSetDocumentFontSize[notebook, size] scales the given notebook.\nSetDocumentFontSize[notebook, Automatic] removes the override."
SetMathFontSize::usage = "SetMathFontSize[size] sizes the displayed, inline and MaTeX mathematics of the input notebook on its own, overriding the size the document scale would give it.\nSetMathFontSize[notebook, size] scales the given notebook.\nSetMathFontSize[notebook, Automatic] returns mathematics to the document scale."
ResetDocumentView::usage = "ResetDocumentView[] returns the input notebook to its stylesheet defaults, leaving no trace of the view overrides.\nResetDocumentView[notebook] resets the given notebook."
InstallLaTeXFonts::usage = "InstallLaTeXFonts[] installs Latin Modern and TeX Gyre OpenType fonts from the local TeX Live distribution."
UpdateMathNotebook::usage = "UpdateMathNotebook[] installs the MathNotebook paclet from the Wolfram Cloud when the published version is newer than the installed one, then rebuilds the front end menus and reopens the palette."
$MathNotebookCloudVersion::usage = "$MathNotebookCloudVersion is the paclet version published in the Wolfram Cloud, or Missing[\"CloudUnreachable\", ...] when the version marker cannot be read."
OpenTutorial::usage = "OpenTutorial[] opens a copy of the MathNotebook tutorial notebook."
$LastHyperlinkCell::usage = "$LastHyperlinkCell is the cell from which the last hyperlink was clicked."
